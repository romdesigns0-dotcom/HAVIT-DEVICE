CONFIG_IDF_TARGET="esp32s3"

CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_HAVIT_DEBUG_USB_CONTROL=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_PANEL_BOARD_DEFAULT_USE_SUPPORTED=y
# Waveshare ESP32-S3-Touch-LCD-1.85 Rev 2.0 (non-C hardware profile).
CONFIG_BOARD_WAVESHARE_ESP32_S3_TOUCH_LCD_1_85=y
CONFIG_ESP_PANEL_DRIVERS_BUS_USE_QSPI=y
CONFIG_ESP_PANEL_DRIVERS_BUS_USE_I2C=y
CONFIG_ESP_PANEL_DRIVERS_LCD_USE_ST77916=y
CONFIG_ESP_PANEL_DRIVERS_TOUCH_USE_CST816S=y
CONFIG_ESP_PANEL_DRIVERS_BACKLIGHT_USE_PWM_LEDC=y
CONFIG_ESP_PANEL_DRIVERS_EXPANDER_USE_TCA95XX_8BIT=y
# LVGL's embedded UI fonts exceed the small built-in allocator; use ESP-IDF heap.
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_CONF_MINIMAL=y
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_BUILD_DEMOS=n
CONFIG_LV_USE_VECTOR_GRAPHIC=y
CONFIG_LV_USE_THORVG=y
CONFIG_LV_USE_THORVG_INTERNAL=y
CONFIG_LV_USE_SVG=y
CONFIG_LV_USE_LABEL=y
CONFIG_LV_USE_BUTTONMATRIX=y
CONFIG_LV_USE_BUTTON=y
CONFIG_LV_USE_MSGBOX=y
CONFIG_LV_USE_FLEX=y
CONFIG_LV_USE_KEYBOARD=y
CONFIG_LV_USE_LINE=y
CONFIG_LV_USE_ARC=y
CONFIG_LV_USE_ROLLER=y
CONFIG_LV_USE_TEXTAREA=y
# CONFIG_ESP_PANEL_DRIVERS_BUS_COMPILE_UNUSED_DRIVERS is not set
# CONFIG_ESP_PANEL_DRIVERS_LCD_COMPILE_UNUSED_DRIVERS is not set
# CONFIG_ESP_PANEL_DRIVERS_TOUCH_COMPILE_UNUSED_DRIVERS is not set
# CONFIG_ESP_PANEL_DRIVERS_BACKLIGHT_COMPILE_UNUSED_DRIVERS is not set
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_LV_USE_IMAGE=y
CONFIG_LV_USE_SNAPSHOT=y
CONFIG_LV_TXT_ENC_UTF8=y

# Secure BLE provisioning, with the smaller NimBLE host. No shared/default PoP.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
# Host buffers may live in PSRAM; radio/DMA and task stacks stay internal.
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=8192
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_PROTOCOMM_SUPPORT_SECURITY_VERSION_1=y
CONFIG_ESP_PROTOCOMM_SUPPORT_SECURITY_VERSION_0=n
CONFIG_ESP_PROTOCOMM_SUPPORT_SECURITY_VERSION_2=n

# HTTPS to the HAVIT device API; keep full certificate verification enabled.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
