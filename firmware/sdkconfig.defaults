CONFIG_IDF_TARGET="esp32s3"

# Pair setup in Chrome/Edge through the Improv Wi-Fi BLE service.
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=n
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
# CONFIG_BT_BLE_50_FEATURES_SUPPORTED is not set
CONFIG_WIFI_CFG_ENABLE_IMPROV_BLE=y
CONFIG_WIFI_CFG_ENABLE_SOFTAP=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_ESP_PANEL_BOARD_DEFAULT_USE_SUPPORTED=y
# Waveshare ESP32-S3-Touch-LCD-1.85 Rev 2.0 (non-C hardware profile).
CONFIG_BOARD_WAVESHARE_ESP32_S3_TOUCH_LCD_1_85=y
CONFIG_ESP_PANEL_DRIVERS_BUS_USE_QSPI=y
CONFIG_ESP_PANEL_DRIVERS_BUS_USE_I2C=y
CONFIG_ESP_PANEL_DRIVERS_LCD_USE_ST77916=y
CONFIG_ESP_PANEL_DRIVERS_TOUCH_USE_CST816S=y
CONFIG_ESP_PANEL_DRIVERS_BACKLIGHT_USE_PWM_LEDC=y
CONFIG_ESP_PANEL_DRIVERS_EXPANDER_USE_TCA95XX_8BIT=y
# LVGL's embedded UI fonts exceed the small built-in allocator; use ESP-IDF heap.
CONFIG_LV_USE_CLIB_MALLOC=y
# CONFIG_ESP_PANEL_DRIVERS_BUS_COMPILE_UNUSED_DRIVERS is not set
# CONFIG_ESP_PANEL_DRIVERS_LCD_COMPILE_UNUSED_DRIVERS is not set
# CONFIG_ESP_PANEL_DRIVERS_TOUCH_COMPILE_UNUSED_DRIVERS is not set
# CONFIG_ESP_PANEL_DRIVERS_BACKLIGHT_COMPILE_UNUSED_DRIVERS is not set
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_USE_FS_MEMFS=y
CONFIG_LV_FS_MEMFS_LETTER=77
CONFIG_LV_USE_OBJ_NAME=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# TLS certificates and record buffers use the available 8 MB PSRAM.
# CONFIG_MBEDTLS_INTERNAL_MEM_ALLOC is not set
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
