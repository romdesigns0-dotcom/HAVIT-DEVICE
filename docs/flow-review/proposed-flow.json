{
  "status": "partially_implemented",
  "implemented_in_firmware": [
    "V2 intro, pairing entry and welcome screens replace the legacy frames",
    "Today profile opens account settings and preserves a return route",
    "Welcome is limited to the first successful account sync in a boot session",
    "Background sync preserves the current screen and refreshes the Today task count in place",
    "Task list filters, paging and completion update existing widgets without rebuilding the screen",
    "Calendar month changes and project calendar selection update existing widgets",
    "Project date schedule goes directly to the local timeline without a simulated network loading delay"
  ],
  "still_unimplemented_or_service_dependent": [
    "Remote task collection parsing and task detail",
    "Remote project generation and save contract",
    "Draft and route parameter persistence across editors",
    "Task detail, field editor, duration picker and milestone editor views"
  ],
  "origin_semantics": "Return stack; preserve draft, selection and active quick session.",
  "route_parameter_requirements": [
    "origin",
    "selected_date",
    "task_id",
    "project_id",
    "draft_id",
    "operation_id",
    "mode"
  ],
  "archived_visual_sources": [
    "frame_1",
    "frame_2",
    "frame_3",
    "firmware:create_home_placeholder"
  ],
